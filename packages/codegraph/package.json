{
  "name": "@fengru/codegraph",
  "version": "0.1.0",
  "description": "In-memory heterogeneous code graph  symbol extraction, PageRank centrality, k-hop ego-graph search, incremental file watcher",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "test": "bun test",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "web-tree-sitter": ">=0.24"
  },
  "peerDependenciesMeta": {
    "web-tree-sitter": {
      "optional": true
    }
  },
  "keywords": ["code-graph", "pagerank", "symbol-search", "ego-graph", "code-analysis"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fengrru/awesome-agent-infra.git",
    "directory": "packages/codegraph"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
