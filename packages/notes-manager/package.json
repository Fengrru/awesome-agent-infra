    }
  },
  "files": ["dist"],
  "scripts": {
    "test": "bun test",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["ai-agent", "notes", "scratchpad", "jsonl", "session-manager"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
